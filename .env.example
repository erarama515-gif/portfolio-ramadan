# — Payload CMS —
# For local development, SQLite works with zero config.
# Override with a full DB URL for staging/production:
# DATABASE_URI=postgres://user:pass@host:5432/db
DATABASE_URI=file:./data/payload.sqlite

# A long random string. Rotate for production.
PAYLOAD_SECRET=change-me-please-a-long-random-string

# Public base URL of the deployed app.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# — Contact form email delivery (Phase 6) —
# RESEND_API_KEY=

# — Media storage (Phase 6 · optional cloud storage) —
# BLOB_READ_WRITE_TOKEN=
